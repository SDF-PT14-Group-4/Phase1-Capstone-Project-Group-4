FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/globaltaste
FRONTEND_ORIGIN=http://localhost:5173
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Optional: access token lifetime in seconds (default 3600, minimum 60)
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
# Comma-separated emails allowed to use the admin pages
ADMIN_EMAILS=
